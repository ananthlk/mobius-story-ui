# mobius-story-ui — Cloud Run deployment config for mobius-os-dev.
# Non-secret runtime config only. Secrets come from GCP Secret Manager.

# ── GCP ─────────────────────────────────────────────────────────────
GCP_PROJECT=mobius-os-dev
GCP_REGION=us-central1

# ── Cloud Run service identity ───────────────────────────────────────
SERVICE_NAME=mobius-story-ui
SERVICE_ACCOUNT=mobius-platform-dev@mobius-os-dev.iam.gserviceaccount.com
AR_REPO=mobius-story-ui
IMAGE_BASE=us-central1-docker.pkg.dev/mobius-os-dev/mobius-story-ui/story-ui

# ── Runtime env ──────────────────────────────────────────────────────
# Chat API — proxy target for /proxy/chat/* routes.
# Points to the deployed mobius-chat Cloud Run service.
CHAT_API_URL=https://mobius-chat-ortabkknqa-uc.a.run.app

# Skills API — provider roster credentialing (optional; falls back gracefully)
# Skills API (provider-roster-credentialing) — not yet deployed to Cloud Run.
# Proxy will return 503 gracefully; story.html handles failure silently.
# Replace with real Cloud Run URL when mobius-skills is deployed.
SKILLS_API_URL=https://mobius-provider-roster-credentialing-ortabkknqa-uc.a.run.app

# Port — Cloud Run convention is 8080
UI_PORT=8080

# ── Cloud Run sizing ─────────────────────────────────────────────────
# Story UI is a static file server + thin proxy — very low memory.
RUN_MEMORY=512Mi
RUN_CPU=1
RUN_CONCURRENCY=80
RUN_TIMEOUT=300
RUN_MIN_INSTANCES=0
RUN_MAX_INSTANCES=5
